{% extends 'base.html.twig' %}

{% block title %}
    Tableau de bord | Supplier Manager
{% endblock %}

{% block body %}

<div class="min-h-screen bg-slate-50">

    {# Header #}
    <header
        class="
            border-b
            border-slate-200
            bg-white
        "
    >

        <div
            class="
                mx-auto
                flex
                max-w-7xl
                items-center
                justify-between
                px-6
                py-4
            "
        >

            <div class="flex items-center gap-3">

                <div
                    class="
                        flex
                        h-10
                        w-10
                        items-center
                        justify-center
                        rounded-xl
                        bg-emerald-500
                        font-bold
                        text-slate-950
                    "
                >
                    SM
                </div>

                <div>
                    <p class="font-semibold text-slate-900">
                        Supplier Manager
                    </p>

                    <p class="text-xs text-slate-500">
                        Gestion fournisseurs
                    </p>
                </div>

            </div>


            <div class="flex items-center gap-4">

                <div class="hidden text-right sm:block">

                    <p
                        class="
                            text-sm
                            font-semibold
                            text-slate-800
                        "
                    >
                        {{ app.user.fullName }}
                    </p>

                    <p class="text-xs text-slate-500">
                        {{ app.user.email }}
                    </p>

                </div>


                <div
                    class="
                        flex
                        h-10
                        w-10
                        items-center
                        justify-center
                        rounded-full
                        bg-slate-100
                        text-sm
                        font-semibold
                        text-slate-700
                    "
                >
                    {{ app.user.firstName|first|upper }}
                    {{ app.user.lastName|first|upper }}
                </div>


                <a
                    href="{{ path('app_logout') }}"
                    class="
                        rounded-lg
                        px-3
                        py-2
                        text-sm
                        font-medium
                        text-slate-500
                        transition
                        hover:bg-slate-100
                        hover:text-slate-900
                    "
                >
                    Déconnexion
                </a>

            </div>

        </div>

    </header>


    <main
        class="
            mx-auto
            max-w-7xl
            px-6
            py-10
        "
    >

        {# Bienvenue #}
        <section class="mb-10">

            <p
                class="
                    mb-2
                    text-sm
                    font-semibold
                    text-emerald-600
                "
            >
                TABLEAU DE BORD
            </p>

            <h1
                class="
                    text-3xl
                    font-bold
                    tracking-tight
                    text-slate-950
                "
            >
                Bonjour {{ app.user.firstName }} 👋
            </h1>

            <p class="mt-3 max-w-2xl text-slate-500">
                Gérez vos consultations fournisseurs et automatisez
                le traitement de vos fichiers Excel depuis un seul espace.
            </p>

        </section>


        {# Action principale #}
        <section
            class="
                mb-8
                overflow-hidden
                rounded-2xl
                bg-slate-950
                p-8
                text-white
                shadow-sm
                md:p-10
            "
        >

            <div
                class="
                    flex
                    flex-col
                    justify-between
                    gap-8
                    md:flex-row
                    md:items-center
                "
            >

                <div>

                    <div
                        class="
                            mb-5
                            flex
                            h-12
                            w-12
                            items-center
                            justify-center
                            rounded-xl
                            bg-emerald-500
                            text-slate-950
                        "
                    >

                        <svg
                            class="h-6 w-6"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M12 16V4m0 0L7 9m5-5 5 5M5 20h14"
                            />
                        </svg>

                    </div>

                    <h2 class="text-2xl font-bold">
                        Nouveau traitement
                    </h2>

                    <p
                        class="
                            mt-2
                            max-w-xl
                            text-slate-400
                        "
                    >
                        Importez votre fichier Excel afin d'analyser
                        les articles et récupérer automatiquement
                        les prix des fournisseurs.
                    </p>

                </div>


                <a
                    href="#"
                    class="
                        inline-flex
                        shrink-0
                        items-center
                        justify-center
                        rounded-xl
                        bg-white
                        px-6
                        py-3
                        font-semibold
                        text-slate-950
                        transition
                        hover:bg-slate-100
                    "
                >
                    Importer un fichier

                    <span class="ml-2">
                        →
                    </span>
                </a>

            </div>

        </section>


        {# Cartes #}
        <section
            class="
                grid
                gap-6
                md:grid-cols-2
                lg:grid-cols-3
            "
        >

            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-6
                "
            >

                <div
                    class="
                        mb-5
                        flex
                        h-11
                        w-11
                        items-center
                        justify-center
                        rounded-xl
                        bg-blue-50
                        text-blue-600
                    "
                >
                    📄
                </div>

                <h3 class="font-semibold text-slate-900">
                    Historique
                </h3>

                <p class="mt-2 text-sm text-slate-500">
                    Retrouvez les fichiers déjà analysés
                    et leurs résultats.
                </p>

                <a
                    href="#"
                    class="
                        mt-5
                        inline-block
                        text-sm
                        font-semibold
                        text-slate-900
                    "
                >
                    Voir l'historique →
                </a>

            </div>


            <div
                class="
                    rounded-2xl
                    border
                    border-slate-200
                    bg-white
                    p-6
                "
            >

                <div
                    class="
                        mb-5
                        flex
                        h-11
                        w-11
                        items-center
                        justify-center
                        rounded-xl
                        bg-emerald-50
                        text-emerald-600
                    "
                >
                    🏢
                </div>

                <h3 class="font-semibold text-slate-900">
                    Fournisseurs
                </h3>

                <p class="mt-2 text-sm text-slate-500">
                    Consultez les fournisseurs actuellement
                    pris en charge par l'application.
                </p>

                <a
                    href="#"
                    class="
                        mt-5
                        inline-block
                        text-sm
                        font-semibold
                        text-slate-900
                    "
                >
                    Voir les fournisseurs →
                </a>

            </div>


            {% if is_granted('ROLE_ADMIN') %}

                <div
                    class="
                        rounded-2xl
                        border
                        border-slate-200
                        bg-white
                        p-6
                    "
                >

                    <div
                        class="
                            mb-5
                            flex
                            h-11
                            w-11
                            items-center
                            justify-center
                            rounded-xl
                            bg-violet-50
                            text-violet-600
                        "
                    >
                        👥
                    </div>

                    <h3 class="font-semibold text-slate-900">
                        Administration
                    </h3>

                    <p class="mt-2 text-sm text-slate-500">
                        Gérez les comptes utilisateurs
                        autorisés à accéder à l'application.
                    </p>

                    <a
                        href="#"
                        class="
                            mt-5
                            inline-block
                            text-sm
                            font-semibold
                            text-slate-900
                        "
                    >
                        Gérer les utilisateurs →
                    </a>

                </div>

            {% endif %}

        </section>

    </main>

</div>

{% endblock %}