{% extends 'base.html.twig' %}

{% block title %}
    Connexion | Supplier Manager
{% endblock %}

{% block body %}

<div class="min-h-screen lg:grid lg:grid-cols-2">

    {# Partie gauche #}
    <div
        class="
            hidden
            lg:flex
            relative
            overflow-hidden
            bg-slate-950
            p-12
            text-white
        "
    >

        <div
            class="
                absolute
                -left-32
                -top-32
                h-96
                w-96
                rounded-full
                bg-emerald-500/20
                blur-3xl
            "
        ></div>

        <div
            class="
                absolute
                -bottom-32
                -right-32
                h-96
                w-96
                rounded-full
                bg-blue-500/20
                blur-3xl
            "
        ></div>

        <div class="relative z-10 flex w-full flex-col">

            <div class="flex items-center gap-3">

                <div
                    class="
                        flex
                        h-11
                        w-11
                        items-center
                        justify-center
                        rounded-xl
                        bg-emerald-500
                        font-bold
                        text-slate-950
                    "
                >
                    SM
                </div>

                <div>
                    <div class="font-semibold">
                        Supplier Manager
                    </div>

                    <div class="text-sm text-slate-400">
                        Gestion fournisseurs
                    </div>
                </div>

            </div>

            <div class="my-auto max-w-xl">

                <p
                    class="
                        mb-5
                        text-sm
                        font-semibold
                        uppercase
                        tracking-[0.2em]
                        text-emerald-400
                    "
                >
                    Gestion des consultations
                </p>

                <h1
                    class="
                        text-4xl
                        font-bold
                        leading-tight
                        xl:text-5xl
                    "
                >
                    Simplifiez le traitement de vos
                    consultations fournisseurs.
                </h1>

                <p
                    class="
                        mt-6
                        max-w-lg
                        text-lg
                        leading-8
                        text-slate-400
                    "
                >
                    Centralisez vos fichiers, récupérez les prix
                    fournisseurs et générez vos tableaux complétés
                    en quelques étapes.
                </p>

            </div>

            <p class="text-sm text-slate-500">
                Application métier sécurisée
            </p>

        </div>

    </div>


    {# Partie droite #}
    <div
        class="
            flex
            min-h-screen
            items-center
            justify-center
            bg-white
            px-6
            py-12
            sm:px-12
        "
    >

        <div class="w-full max-w-md">

            {# Logo mobile #}
            <div class="mb-10 lg:hidden">

                <div class="flex items-center gap-3">

                    <div
                        class="
                            flex
                            h-11
                            w-11
                            items-center
                            justify-center
                            rounded-xl
                            bg-emerald-500
                            font-bold
                            text-slate-950
                        "
                    >
                        SM
                    </div>

                    <span class="font-semibold">
                        Supplier Manager
                    </span>

                </div>

            </div>


            {# Titre #}
            <div class="mb-8">

                <h2
                    class="
                        text-3xl
                        font-bold
                        tracking-tight
                        text-slate-900
                    "
                >
                    Bon retour 👋
                </h2>

                <p class="mt-3 text-slate-500">
                    Connectez-vous pour accéder à votre espace.
                </p>

            </div>


            {# Message d'erreur Symfony Security #}
            {% if error %}

                <div
                    class="
                        mb-6
                        rounded-xl
                        border
                        border-red-200
                        bg-red-50
                        px-4
                        py-3
                        text-sm
                        text-red-700
                    "
                    role="alert"
                >
                    <div class="flex items-start gap-3">

                        <div
                            class="
                                mt-0.5
                                flex
                                h-5
                                w-5
                                shrink-0
                                items-center
                                justify-center
                                rounded-full
                                bg-red-100
                                text-xs
                                font-bold
                                text-red-700
                            "
                        >
                            !
                        </div>

                        <div>
                            {{ error.messageKey|trans(
                                error.messageData,
                                'security'
                            ) }}
                        </div>

                    </div>
                </div>

            {% endif %}


            {# Utilisateur déjà connecté #}
            {% if app.user %}

                <div
                    class="
                        mb-6
                        rounded-xl
                        border
                        border-emerald-200
                        bg-emerald-50
                        p-4
                        text-sm
                        text-emerald-800
                    "
                >
                    Vous êtes déjà connecté en tant que
                    <strong>
                        {{ app.user.userIdentifier }}
                    </strong>.

                    <div class="mt-3">

                        <a
                            href="{{ path('app_dashboard') }}"
                            class="font-semibold underline"
                        >
                            Accéder au tableau de bord
                        </a>

                    </div>
                </div>

            {% endif %}


            {# Formulaire de connexion #}
            <form
                method="post"
                class="space-y-6"
            >

                {# Email #}
                <div>

                    <label
                        for="username"
                        class="
                            mb-2
                            block
                            text-sm
                            font-semibold
                            text-slate-700
                        "
                    >
                        Adresse email
                    </label>

                    <input
                        type="email"
                        value="{{ last_username }}"
                        name="_username"
                        id="username"
                        autocomplete="email"
                        required
                        autofocus
                        placeholder="vous@entreprise.com"
                        class="
                            block
                            w-full
                            rounded-xl
                            border
                            border-slate-300
                            bg-white
                            px-4
                            py-3
                            outline-none
                            transition
                            placeholder:text-slate-400
                            focus:border-emerald-500
                            focus:ring-4
                            focus:ring-emerald-500/10
                        "
                    >

                </div>


                {# Mot de passe #}
                <div>

                    <label
                        for="password"
                        class="
                            mb-2
                            block
                            text-sm
                            font-semibold
                            text-slate-700
                        "
                    >
                        Mot de passe
                    </label>

                    <input
                        type="password"
                        name="_password"
                        id="password"
                        autocomplete="current-password"
                        required
                        placeholder="Votre mot de passe"
                        class="
                            block
                            w-full
                            rounded-xl
                            border
                            border-slate-300
                            bg-white
                            px-4
                            py-3
                            outline-none
                            transition
                            placeholder:text-slate-400
                            focus:border-emerald-500
                            focus:ring-4
                            focus:ring-emerald-500/10
                        "
                    >

                </div>


                {# Protection CSRF #}
                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token('authenticate') }}"
                >


                {# Bouton de connexion #}
                <button
                    type="submit"
                    class="
                        flex
                        w-full
                        cursor-pointer
                        items-center
                        justify-center
                        rounded-xl
                        bg-slate-950
                        px-4
                        py-3.5
                        font-semibold
                        text-white
                        transition
                        hover:bg-slate-800
                        focus:outline-none
                        focus:ring-4
                        focus:ring-slate-950/20
                    "
                >
                    Se connecter

                    <svg
                        class="ml-2 h-5 w-5"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M5 12h14m-6-6 6 6-6 6"
                        />
                    </svg>

                </button>

            </form>


            <div
                class="
                    mt-10
                    border-t
                    border-slate-100
                    pt-6
                    text-center
                    text-xs
                    text-slate-400
                "
            >
                Accès réservé aux utilisateurs autorisés.
            </div>

        </div>

    </div>

</div>

{% endblock %}