{% extends 'base.html.twig' %}

{% block title %}
    Modifier {{ user.fullName }} | Supplier Manager
{% endblock %}

{% block body %}

<div class="min-h-screen bg-slate-50">

    <header class="border-b border-slate-200 bg-white">

        <div
            class="
                mx-auto
                flex
                max-w-5xl
                items-center
                justify-between
                px-6
                py-4
            "
        >
            <a
                href="{{ path('app_dashboard') }}"
                class="flex items-center gap-3"
            >
                <div
                    class="
                        flex
                        h-10
                        w-10
                        items-center
                        justify-center
                        rounded-xl
                        bg-emerald-500
                        font-bold
                        text-slate-950
                    "
                >
                    SM
                </div>

                <span class="font-semibold">
                    Supplier Manager
                </span>
            </a>

            <a
                href="{{ path('admin_user_index') }}"
                class="text-sm font-semibold text-slate-600"
            >
                ← Utilisateurs
            </a>
        </div>

    </header>


    <main class="mx-auto max-w-3xl px-6 py-10">

        <div class="mb-8">

            <p
                class="
                    mb-2
                    text-sm
                    font-semibold
                    text-emerald-600
                "
            >
                ADMINISTRATION
            </p>

            <h1
                class="
                    text-3xl
                    font-bold
                    tracking-tight
                    text-slate-950
                "
            >
                Modifier {{ user.fullName }}
            </h1>

            <p class="mt-2 text-slate-500">
                Modifiez les informations et les autorisations du compte.
            </p>

        </div>


        <div
            class="
                rounded-2xl
                border
                border-slate-200
                bg-white
                p-6
                shadow-sm
                md:p-8
            "
        >
            {% include 'admin/user/_form.html.twig' with {
                button_label: 'Enregistrer les modifications'
            } %}
        </div>

    </main>

</div>

{% endblock %}